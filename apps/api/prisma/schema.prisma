// TeamFlow database schema.
// Change it, then run `npx prisma migrate dev --name <change>`. Never edit tables by hand.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The API is compiled to CommonJS by Nx/webpack.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased and trimmed (normalised in the service layer).
  email        String   @unique
  name         String
  /// argon2id hash. The plain password is never stored or logged.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  memberships   Membership[]
  reportedTasks Task[]

  @@map("users")
}

/// Ordered from most to least privileged. Ranks live in @teamflow/shared.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// The tenant boundary: every project, task and comment will belong to one workspace.
model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  projects    Project[]
  tasks       Task[]

  @@map("workspaces")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Short uppercase code used in task numbers (e.g. "TF" -> TF-12). Immutable.
  key         String
  name        String
  description String?
  /// Last task number handed out (TF-1, TF-2, ...). Incremented in the same
  /// transaction that creates a task, so numbers are never reused or duplicated.
  taskCounter Int      @default(0) @map("task_counter")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  /// Keys are unique per workspace (two teams can both have "WEB").
  /// The index also serves "list projects of workspace W".
  @@unique([workspaceId, key])
  @@map("projects")
}

/// Kanban columns, in board order.
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  /// Denormalised from the project so every task query can filter by tenant directly.
  workspaceId          String       @map("workspace_id") @db.Uuid
  projectId            String       @map("project_id") @db.Uuid
  /// Per-project sequence: shown as "<project key>-<number>", e.g. WEB-12.
  number               Int
  title                String
  description          String?
  status               TaskStatus   @default(TODO)
  priority             TaskPriority @default(MEDIUM)
  /// Order inside its status column (0 = top). Rewritten for the column on each move.
  position             Int
  /// The assignee's MEMBERSHIP (not user): when they leave the workspace the
  /// membership row is deleted and Postgres sets this to NULL automatically.
  assigneeMembershipId String?      @map("assignee_membership_id") @db.Uuid
  /// Who created the task. Kept (as NULL) if that account is deleted.
  reporterId           String?      @map("reporter_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  Membership? @relation(fields: [assigneeMembershipId], references: [id], onDelete: SetNull)
  reporter  User?       @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  /// Serves the board query: one project's tasks, grouped by column, in order.
  @@index([projectId, status, position])
  @@index([workspaceId])
  @@index([assigneeMembershipId])
  @@map("tasks")
}

/// A user's role in one workspace. Access to workspace data is decided by this row.
model Membership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]

  /// One membership per user per workspace; also serves "is X a member of W?" lookups.
  @@unique([workspaceId, userId])
  /// "Which workspaces is X in?" (the workspace switcher).
  @@index([userId])
  @@map("memberships")
}

/// One row per issued refresh token. Tokens issued by rotating each other share a
/// familyId, so presenting an already-used token can revoke the whole chain.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the random token. The raw token only ever lives in the cookie.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set when the token is rotated (used) or revoked (logout / reuse detected).
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
