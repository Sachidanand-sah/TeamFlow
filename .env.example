# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- API ---
NODE_ENV=development
# Not plain PORT: Nx loads .env into every task and the Angular dev server would pick it up.
API_PORT=3000
# Origin of the Angular app allowed by CORS (exact match, no wildcards).
CORS_ORIGIN=http://localhost:4200
# Production only: behind a hosting proxy (Render) and serving the built web app.
TRUST_PROXY=false
SERVE_WEB_APP=false

# --- Database (matches docker-compose defaults) ---
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=teamflow
POSTGRES_DB=teamflow
DATABASE_URL=postgresql://teamflow:teamflow@localhost:5432/teamflow?schema=public
# Optional: direct (non-pooled) URL used by Prisma migrations, e.g. on Neon.
# DIRECT_URL=

# --- Auth ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Access token lifetime in seconds (short-lived on purpose).
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=7

# --- Object storage (S3 API; MinIO locally via docker-compose) ---
MINIO_ROOT_USER=teamflow
MINIO_ROOT_PASSWORD=teamflow-secret
# Browsers upload/download directly with signed URLs, so this must be reachable from the browser.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=teamflow-attachments
S3_ACCESS_KEY=teamflow
S3_SECRET_KEY=teamflow-secret

# --- Queues and email (Redis + Mailpit from docker-compose) ---
REDIS_URL=redis://localhost:6379
# Mailpit catches every email locally; read them at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=TeamFlow <no-reply@teamflow.local>
# Public URL of the web app, used for links inside emails.
APP_URL=http://localhost:4200
